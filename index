            { q: "ข้อใดเป็นไปตามเกณฑ์การเข้าถึง (Accessibility) พื้นฐานสำหรับข้อความในเว็บ?", options: ["ความต่างสีระหว่างข้อความและพื้นหลังอย่างน้อย 4.5:1", "ใช้สีแดงเพื่อสื่อความหมายว่าผิดเท่านั้น", "ใช้ตัวอักษรขนาด 10px เป็นมาตรฐาน", "รูปภาพทุกรูปไม่ต้องมี alt text เพื่อลดขนาดไฟล์"], ans: 0, m: 3, exp: "WCAG กำหนดความต่างสีสำหรับข้อความปกติที่ 4.5:1" },
            { q: "การทดสอบแบบ Formative Assessment มีจุดประสงค์หลักเพื่ออะไร?", options: ["เพื่อพัฒนาและให้ข้อมูลป้อนกลับระหว่างเรียน", "เพื่อตัดเกรดตอนสิ้นเทอม", "เพื่อเปรียบเทียบผลลัพธ์การลงทุน (ROI)", "เพื่อตัดสินว่าผู้เรียนผ่านหรือไม่ผ่าน"], ans: 0, m: 4, exp: "Formative เน้นเพื่อพัฒนา (Assessment for Learning) ระหว่างทาง" },
            { q: "หากต้องการวัดว่าผู้เรียนนำความรู้ไปใช้ในที่ทำงานจริงหรือไม่ ต้องประเมินตาม Kirkpatrick ระดับใด?", options: ["ระดับ 3: Behavior", "ระดับ 1: Reaction", "ระดับ 2: Learning", "ระดับ 4: Results"], ans: 0, m: 4, exp: "Behavior (ระดับ 3) คือการประเมินพฤติกรรมการนำไปประยุกต์ใช้จริง" }
        ];

        /* --- UI Helpers --- */
        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // Fisher-Yates Shuffle
        function shuffleArray(array) {
            let arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        /* --- Core Logic --- */
        function renderSidebar() {
            const list = document.getElementById('navList');
            list.innerHTML = '';
            navStructure.forEach(item => {
                const li = document.createElement('li');
                li.className = `nav-item ${state.currentPage === item.id ? 'active' : ''} ${state.completedPages.includes(item.id) ? 'completed' : ''}`;
                const check = document.createElement('span');
                check.className = 'check';
                check.textContent = state.completedPages.includes(item.id) ? '✓' : '';
                
                const text = document.createElement('span');
                text.textContent = item.title;
                
                li.appendChild(check);
                li.appendChild(text);
                list.appendChild(li);
            });
        }

        function navigate(pageId) {
            if (pageId !== 'home' && !state.nickname && pageId !== 'summary') {
                const input = document.getElementById('nicknameInput').value.trim();
                if (!input) { showToast('กรุณากรอกชื่อเล่นก่อนเริ่มเรียน'); document.getElementById('nicknameInput').focus(); return; }
                state.nickname = input;
            }

            // Mark prev as complete
            if (!state.completedPages.includes(state.currentPage)) {
                state.completedPages.push(state.currentPage);
            }

            // Lock logic
            if (pageId === 'posttest' && (!state.formative.m1 || !state.formative.m2 || !state.formative.m3 || !state.formative.m4)) {
                showToast('กรุณาทำกิจกรรมและทดสอบย่อยให้ครบทุกบทก่อน');
                return;
            }
            if (pageId === 'summary' && state.postTestScore === null) {
                showToast('กรุณาทำแบบทดสอบหลังเรียนก่อน');
                return;
            }

            // Toggle active sections
            document.querySelectorAll('.page-section').forEach(el => el.classList.remove('active'));
            const targetEl = document.getElementById(`p-${pageId}`);
            if(targetEl) targetEl.classList.add('active');

            state.currentPage = pageId;
            saveState();
            renderSidebar();
            
            // Special renders
            if (pageId === 'summary') renderSummary();
            
            // Mobile auto-close
            if (window.innerWidth <= 900) {
                document.getElementById('sidebar').classList.remove('open');
                document.getElementById('overlay').classList.remove('open');
            }
            window.scrollTo(0, 0);
        }

        /* --- Quizzes Generation --- */
        function renderQuiz(containerId, questions, prefix) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            
            questions.forEach((qObj, index) => {
                const qNum = index + 1;
                const div = document.createElement('div');
                div.className = 'question-block';
                
                const qText = document.createElement('div');
                qText.className = 'question-text';
                qText.textContent = `${qNum}. ${qObj.q}`;
                div.appendChild(qText);

                // Shuffle options
                let optionObjects = qObj.options.map((opt, i) => ({ text: opt, isCorrect: i === qObj.ans }));
                optionObjects = shuffleArray(optionObjects);

                optionObjects.forEach((optObj, optIndex) => {
                    const label = document.createElement('label');
                    label.className = 'option-label';
                    
                    const radio = document.createElement('input');
                    radio.type = 'radio';
                    radio.name = `${prefix}_q${index}`;
                    radio.value = optObj.isCorrect ? '1' : '0';
                    
                    label.appendChild(radio);
                    label.appendChild(document.createTextNode(optObj.text));
                    div.appendChild(label);
                });
                
                // Feedback div (for formative)
                if (prefix.startsWith('m')) {
                    const fb = document.createElement('div');
                    fb.id = `${prefix}_fb_${index}`;
                    fb.className = 'feedback';
                    fb.textContent = qObj.exp;
                    div.appendChild(fb);
                }

                container.appendChild(div);
            });
        }

        function checkQuiz(prefix, questions) {
            let allAnswered = true;
            let score = 0;
            questions.forEach((_, index) => {
                const selected = document.querySelector(`input[name="${prefix}_q${index}"]:checked`);
                if (!selected) allAnswered = false;
                else {
                    if (selected.value === '1') score++;
                    if (prefix.startsWith('m')) {
                        const fb = document.getElementById(`${prefix}_fb_${index}`);
                        if (selected.value === '1') {
                            fb.className = 'feedback correct';
                            fb.innerHTML = `✅ ถูกต้อง! ${questions[index].exp}`;
                        } else {
                            fb.className = 'feedback incorrect';
                            fb.innerHTML = `❌ ยังไม่ถูก.. ${questions[index].exp}`;
                        }
                    }
                }
            });
            return { allAnswered, score };
        }

        /* --- Activities Logic --- */
        // M1: ADDIE
        let addieState = [null, null, null, null, null];
        const correctAddie = ['A', 'D1', 'D2', 'I', 'E']; // Using D1, D2 internally for mapping
        
        document.querySelectorAll('.addie-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const val = this.getAttribute('data-val');
                const text = this.textContent;
                const emptySlotIndex = addieState.indexOf(null);
                if (emptySlotIndex !== -1 && !this.classList.contains('used')) {
                    addieState[emptySlotIndex] = val;
                    const slot = document.querySelector(`.addie-slot[data-index="${emptySlotIndex}"]`);
                    slot.textContent = `${emptySlotIndex + 1}. ${text}`;
                    slot.style.borderStyle = 'solid';
                    slot.style.borderColor = 'var(--primary)';
                    this.classList.add('used');
                }
            });
        });

        document.querySelectorAll('.addie-slot').forEach(slot => {
            slot.addEventListener('click', function() {
                const index = this.getAttribute('data-index');
                const val = addieState[index];
                if (val) {
                    addieState[index] = null;
                    this.textContent = `${parseInt(index) + 1}. (ว่าง)`;
                    this.style.borderStyle = 'dashed';
                    this.style.borderColor = 'var(--border)';
                    document.querySelector(`.addie-btn[data-val="${val}"]`).classList.remove('used');
                }
            });
        });

        document.getElementById('btnCheckAddie').addEventListener('click', () => {
            if (addieState.includes(null)) { showToast('กรุณาเรียงให้ครบ 5 ขั้น'); return; }
            const fb = document.getElementById('addieFeedback');
            if (JSON.stringify(addieState) === JSON.stringify(correctAddie)) {
                fb.className = 'feedback correct'; fb.innerHTML = '✅ ถูกต้อง! Analysis -> Design -> Development -> Implementation -> Evaluation';
            } else {
                fb.className = 'feedback incorrect'; fb.innerHTML = '❌ ยังไม่ถูกต้อง ลองพิจารณาลำดับใหม่ (วิเคราะห์ -> ออกแบบ -> พัฒนา -> ใช้ -> ประเมิน)';
            }
        });

        // Dropdown Match Maker
        function createMatchActivity(containerId, items, options) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            items.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = 'match-row';
                const textDiv = document.createElement('div');
                textDiv.textContent = item.text;
                
                const select = document.createElement('select');
                select.id = `${containerId}_sel_${index}`;
                const defaultOpt = document.createElement('option');
                defaultOpt.value = ""; defaultOpt.textContent = "-- เลือกคำตอบ --";
                select.appendChild(defaultOpt);
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt.val; option.textContent = opt.label;
                    select.appendChild(option);
                });
                
                row.appendChild(textDiv);
                row.appendChild(select);
                container.appendChild(row);
            });
        }

        function checkMatchActivity(containerId, items, fbId, correctExp) {
            let allFilled = true;
            let allCorrect = true;
            items.forEach((item, index) => {
                const val = document.getElementById(`${containerId}_sel_${index}`).value;
                if (!val) allFilled = false;
                if (val !== item.ans) allCorrect = false;
            });
            if (!allFilled) { showToast('กรุณาเลือกให้ครบทุกข้อ'); return; }
            
            const fb = document.getElementById(fbId);
            if (allCorrect) {
                fb.className = 'feedback correct'; fb.innerHTML = `✅ ถูกต้องทั้งหมด! <br><small>${correctExp}</small>`;
            } else {
                fb.className = 'feedback incorrect'; fb.innerHTML = '❌ ยังมีข้อที่ไม่ถูกต้อง ลองทบทวนดูอีกครั้ง';
            }
        }

        // M2: Gagné
        const m2Items = [
            { text: "ครูเปิดคลิปวิดีโอสั้นๆ ที่น่าตื่นเต้นก่อนเริ่มบทเรียน", ans: "1" },
            { text: "ครูให้ทำแบบทดสอบ Pop Quiz 10 ข้อ ท้ายคาบ", ans: "8" },
            { text: "ครูให้คำแนะนำระหว่างที่นักเรียนกำลังติดขัดในการทำโปรเจกต์", ans: "5" }
        ];
        const m2Opts = [ {val:"1", label:"Gain Attention (ดึงดูดความสนใจ)"}, {val:"5", label:"Provide Guidance (ชี้แนะ)"}, {val:"8", label:"Assess Performance (ประเมินผล)"} ];
        createMatchActivity('gagneMatches', m2Items, m2Opts);
        document.getElementById('btnCheckGagne').addEventListener('click', () => checkMatchActivity('gagneMatches', m2Items, 'gagneFeedback', 'วิดีโอ=ดึงดูดความสนใจ, Quiz=ประเมิน, ให้คำแนะนำ=ชี้แนะแนวทาง'));

        // M3: Mayer
        const m3Items = [
            { text: "มีโลโก้มหาวิทยาลัยขนาดใหญ่ และเพลงบรรเลงประกอบตลอดเวลา", ans: "coherence" },
            { text: "คำอธิบายกราฟแท่ง ถูกนำไปแยกไว้ในหน้าถัดไป", ans: "spatial" },
            { text: "ครูอ่านเนื้อหาบนสไลด์ที่มีตัวหนังสือเต็มหน้าจอให้ฟังทุกตัวอักษร", ans: "redundancy" }
        ];
        const m3Opts = [ {val:"coherence", label:"ละเมิด Coherence (ความสอดคล้อง)"}, {val:"spatial", label:"ละเมิด Spatial Contiguity (ใกล้ชิด)"}, {val:"redundancy", label:"ละเมิด Redundancy (ซ้ำซ้อน)"} ];
        createMatchActivity('mayerMatches', m3Items, m3Opts);
        document.getElementById('btnCheckMayer').addEventListener('click', () => checkMatchActivity('mayerMatches', m3Items, 'mayerFeedback', 'สิ่งที่ไม่เกี่ยวละเมิด Coherence, ข้อความห่างภาพละเมิด Spatial, อ่านตามสไลด์ละเมิด Redundancy'));

        // M4: Kirkpatrick
        const m4Items = [
            { text: "ยอดขายของทีมเพิ่มขึ้น 15% หลังผ่านการอบรม", ans: "4" },
            { text: "ผู้เรียนทำแบบสอบถามให้คะแนนความพึงพอใจ 4.5/5", ans: "1" },
            { text: "หัวหน้างานสังเกตเห็นพนักงานใช้เทคนิคใหม่ตอนคุยกับลูกค้า", ans: "3" }
        ];
        const m4Opts = [ {val:"1", label:"L1: Reaction"}, {val:"2", label:"L2: Learning"}, {val:"3", label:"L3: Behavior"}, {val:"4", label:"L4: Results"} ];
        createMatchActivity('kirkMatches', m4Items, m4Opts);
        document.getElementById('btnCheckKirk').addEventListener('click', () => checkMatchActivity('kirkMatches', m4Items, 'kirkFeedback', 'ยอดขาย=Results, แบบสอบถาม=Reaction, สังเกตพฤติกรรม=Behavior'));


        /* --- Initialization & Event Listeners --- */
        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            
            // Theme setup
            const savedTheme = localStorage.getItem('eld101_theme');
            if (savedTheme) { document.documentElement.setAttribute('data-theme', savedTheme); }
            else if (window.matchMedia('(prefers-color-scheme: dark)').matches) { document.documentElement.setAttribute('data-theme', 'dark'); }

            document.getElementById('themeToggle').addEventListener('click', () => {
                const current = document.documentElement.getAttribute('data-theme');
                const target = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', target);
                localStorage.setItem('eld101_theme', target);
            });

            // Mobile menu setup
            document.getElementById('openSidebar').addEventListener('click', () => {
                document.getElementById('sidebar').classList.add('open');
                document.getElementById('overlay').classList.add('open');
            });
            document.getElementById('closeSidebar').addEventListener('click', () => {
                document.getElementById('sidebar').classList.remove('open');
                document.getElementById('overlay').classList.remove('open');
            });
            document.getElementById('overlay').addEventListener('click', () => {
                document.getElementById('sidebar').classList.remove('open');
                document.getElementById('overlay').classList.remove('open');
            });

            // Restart Button Logic (Double click pattern)
            const btnRestart = document.getElementById('btnRestart');
            let restartConfirm = false;
            btnRestart.addEventListener('click', () => {
                if (!restartConfirm) {
                    restartConfirm = true;
                    btnRestart.textContent = "ยืนยันเริ่มใหม่? (คลิกอีกครั้ง)";
                    btnRestart.classList.add('btn-danger');
                    btnRestart.classList.remove('btn-secondary');
                    setTimeout(() => {
                        restartConfirm = false;
                        btnRestart.textContent = "เริ่มใหม่ทั้งหมด";
                        btnRestart.classList.remove('btn-danger');
                        btnRestart.classList.add('btn-secondary');
                    }, 3000);
                } else {
                    localStorage.removeItem(STORAGE_KEY);
                    location.reload();
                }
            });

            // Initialize Formative Quizzes
            renderQuiz('m1-quiz-container', questionBank.filter(q => q.m === 1), 'm1');
            renderQuiz('m2-quiz-container', questionBank.filter(q => q.m === 2), 'm2');
            renderQuiz('m3-quiz-container', questionBank.filter(q => q.m === 3), 'm3');
            renderQuiz('m4-quiz-container', questionBank.filter(q => q.m === 4), 'm4');

            // Pre/Post Initializers
            renderQuiz('pretest-container', questionBank, 'pre');
            renderQuiz('posttest-container', questionBank, 'post');

            // Button wiring
            document.getElementById('btnStartCourse').addEventListener('click', () => navigate('pretest'));
            
            document.getElementById('btnSubmitPretest').addEventListener('click', () => {
                const res = checkQuiz('pre', questionBank);
                if (!res.allAnswered) { showToast('กรุณาตอบให้ครบทุกข้อ'); return; }
                state.preTestScore = res.score;
                navigate('m1-content');
            });

            ['m1', 'm2', 'm3', 'm4'].forEach(m => {
                document.getElementById(`btnSubmit${m.toUpperCase()}`).addEventListener('click', () => {
                    const qs = questionBank.filter(q => q.m === parseInt(m[1]));
                    const res = checkQuiz(m, qs);
                    if (!res.allAnswered) { showToast('กรุณาตอบให้ครบทุกข้อ'); return; }
                    state.formative[m] = true;
                    document.getElementById(`btnSubmit${m.toUpperCase()}`).style.display = 'none'; // hide submit
                });
            });

            document.getElementById('btnSubmitPosttest').addEventListener('click', () => {
                const res = checkQuiz('post', questionBank);
                if (!res.allAnswered) { showToast('กรุณาตอบให้ครบทุกข้อ'); return; }
                state.postTestScore = res.score;
                navigate('summary');
            });

            // Restore Nickname
            if (state.nickname) document.getElementById('nicknameInput').value = state.nickname;

            // Route to saved page
            navigate(state.currentPage);
        });

        function renderSummary() {
            document.getElementById('sumName').textContent = `ผู้เรียน: ${state.nickname}`;
            
            const pre = state.preTestScore;
            const post = state.postTestScore;
            const max = questionBank.length;

            document.getElementById('sumPre').textContent = `${pre} / ${max}`;
            document.getElementById('sumPost').textContent = `${post} / ${max}`;

            let gain = 0;
            let gainText = "";
            let interpret = "";

            if (pre === max) {
                if (post === max) { gainText = "N/A"; interpret = "ยอดเยี่ยมมาก! พื้นฐานแน่นและรักษามาตรฐานไว้ได้ดี"; }
                else { gainText = "< 0"; interpret = "คะแนนลดลง อาจเกิดจากการสับสนหรือลืมเนื้อหา"; }
            } else {
                gain = (post - pre) / (max - pre);
                gainText = gain.toFixed(2);
                
                if (gain < 0) {
                    interpret = "คะแนนลดลง (Negative Gain) ข้อสอบอาจยากขึ้นหรือมีจุดสับสน ควรทบทวนเนื้อหาใหม่";
                } else if (gain >= 0.7) {
                    interpret = "ระดับการเรียนรู้สูง (High Gain) - คุณบรรลุวัตถุประสงค์อย่างยอดเยี่ยม";
                } else if (gain >= 0.3) {
                    interpret = "ระดับการเรียนรู้ปานกลาง (Medium Gain) - คุณมีความเข้าใจเนื้อหาดี";
                } else {
                    interpret = "ระดับการเรียนรู้ต่ำ (Low Gain) - อาจต้องทบทวนเนื้อหาบางส่วนเพิ่มเติม";
                }
            }

            document.getElementById('sumGain').textContent = gainText;
            document.getElementById('sumInterpretation').innerHTML = `<strong>ผลการวิเคราะห์:</strong> ${interpret}`;
        }

    </script>
</body>
